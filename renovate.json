{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Track C: Renovate as the OSS auto-remediation engine. osvVulnerabilityAlerts makes it open fix PRs when a CVE is published against a pinned dep.",
  "extends": ["config:recommended"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "automerge": false,
    "labels": ["security", "remediation"]
  },
  "pip_requirements": {
    "fileMatch": ["(^|/)requirements\\.txt$"]
  },
  "packageRules": [
    {
      "description": "Prefer Chainguard Libraries as the source for Python deps",
      "matchDatasources": ["pypi"],
      "registryUrls": ["https://libraries.cgr.dev/python/simple"]
    },
    {
      "description": "Group + label security updates distinctly",
      "matchUpdateTypes": ["patch", "minor"],
      "labels": ["dependencies"]
    }
  ]
}
